# Copy to .env and edit. Never commit .env.

# Required. Base URL of your Jellyfin server (no trailing slash needed).
# The app refuses to start until this is set.
JELLYFIN_URL=

# Optional. Jellyfin API key used by public/unauthenticated read routes (e.g.
# home catalog, shared track pages, audio/cover proxy).
JELLYFIN_API_KEY=

# Optional. Local filesystem path to the Jellyfin music library directory.
# When set, uploaded audio + .lrc files are written here and a library refresh is triggered.
JELLYFIN_LIBRARY_DIR=

# Base URL for share links and Open Graph tags (no trailing slash needed).
# On Railway, leave it unset: it defaults to https://$RAILWAY_PUBLIC_DOMAIN.
PUBLIC_URL=http://localhost:3000

# Cookie signing key. Leave empty to generate one into the data volume.
SESSION_SECRET=

# Leave empty when the app is reached directly. Set to "true" (or the proxy's
# IP) behind a reverse proxy or Cloudflare Tunnel, so the login rate limit
# sees real client IPs. Also accepts a hop count or a comma list of IPs/CIDRs.
TRUST_PROXY=
# Header your proxy sets to the client IP (e.g. X-Real-IP, CF-Connecting-IP),
# used for the rate limits instead of X-Forwarded-For. Only for a proxy that
# always overwrites it. On Railway it defaults to X-Real-IP; leave it empty.
CLIENT_IP_HEADER=

# Host address and port the compose file publishes. Set APP_BIND=127.0.0.1 when
# a reverse proxy on the same host fronts the app (see TRUST_PROXY above).
APP_BIND=0.0.0.0
APP_PORT=3000

# Only for running outside Docker (npm start): the data directory and the HTTP
# port. With Docker leave both commented out: the image keeps its data in /data
# (the letra-data volume) and its health check expects port 3000. To publish
# the app on another port, change APP_PORT above.
# DATA_DIR=/data
# PORT=3000

# Upload size limit in MB.
MAX_UPLOAD_MB=100

# auto | claude | chat | libretranslate | fake | off
TRANSLATOR=auto

# Claude translation. Enabled when the key is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Chat engine: any endpoint that speaks OpenAI's chat completions. Enabled when the URL and the model are set.
# Hugging Face: TRANSLATE_API_URL=https://router.huggingface.co/v1, a token with the
# "Inference Providers" permission as the key, and the model id as the router names it.
# With the hymt compose profile: TRANSLATE_API_URL=http://hymt:8080/v1, TRANSLATE_MODEL=Hy-MT2-1.8B,
# no key, and TRANSLATE_DETECT_LANGUAGE=false (the small model can not name languages).
TRANSLATE_API_URL=
TRANSLATE_API_KEY=
TRANSLATE_MODEL=
TRANSLATE_DETECT_LANGUAGE=true

# LibreTranslate fallback. With the compose profile use http://libretranslate:5000
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Development/testing only:
# LRCLIB_URL=https://lrclib.net
# WEB_DIR=
