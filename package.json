{
  "name": "letra-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node server/index.ts",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test --trace off",
    "fixtures": "node test/fixtures/make-fixtures.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "11.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@phosphor-icons/core": "2.1.1",
    "fastify": "5.12.8",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "jsqr": "1.4.0",
    "node-id3": "0.2.9",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
